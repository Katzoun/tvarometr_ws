# Development override - copy to docker-compose.override.yml and compose picks
# it up automatically. It is git-ignored, so it never follows onto the
# machine.
#
# Mounts the workspace source over the copy baked into the image, so you can
# edit nodes on the host and rebuild inside the running container instead of
# rebuilding the whole image (seconds instead of minutes):
#
#   docker compose exec vision bash -lc \
#     "cd /workspace && colcon build --packages-select tvarometr_inference"
#   docker compose restart vision
#
# colcon copies the sources into install/ rather than symlinking them, so the
# build step is needed even for a one-line Python change - but it only takes a
# second or two, and nothing gets re-downloaded.
#
# `git lfs pull` has to have been run on the host, or the mounted weights show up
# inside the container as LFS pointer files.

services:
  vision:
    volumes:
      - ./src/tvarometr_inference:/workspace/src/tvarometr_inference
      - ./src/tvarometr_interfaces:/workspace/src/tvarometr_interfaces
      # Swap a weight file without rebuilding the 8 GB image
      - ./models:/opt/tvarometr/models

  control:
    # Idle instead of launching the node, so the node can be started by hand from
    # an interactive shell - its output lands in that terminal and Ctrl+C stops
    # it, the way it behaves outside a container.
    #   docker compose exec control bash
    #   ros2 launch tvarometr_robot_control robot_control.launch.py backend:=sim
    command: sleep infinity
    volumes:
      - ./src/tvarometr_robot_control:/workspace/src/tvarometr_robot_control
      - ./src/tvarometr_robot_control_msgs:/workspace/src/tvarometr_robot_control_msgs
