// Behaviour tree development. A thin wrapper around the `orchestrator` service
// in docker-compose.dev.yml, so the editor and the CLI land in the same
// container.
{
    "name": "orchestrator",

    "dockerComposeFile": [
        "../../docker-compose.dev.yml"
    ],
    "service": "orchestrator",
    "runServices": ["orchestrator"],
    "workspaceFolder": "/workspace",

    // Closing the window must not stop vision in another one.
    "shutdownAction": "none",

    // The image carries dependencies only, so build the packages once on create.
    // Packages, output paths and cmake flags come from
    // docker/colcon-defaults-orchestrator.yaml.
    "postCreateCommand": "bash -c 'source /ros-env.sh && colcon build --symlink-install'",

    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "openai.chatgpt",
                "llvm-vs-code-extensions.vscode-clangd",
                // Only for the debugger: it owns cppdbg. IntelliSense off below.
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                // Replaces ms-iot.vscode-ros, which is archived.
                "Ranch-Hand-Robotics.rde-ros-2"
            ],
            "settings": {
                // The merged file, so jumping into behaviortree_ros2 works.
                "clangd.arguments": [
                    "--compile-commands-dir=/opt/colcon_ws/build"
                ],
                // clangd reads the code; two engines would fight over it.
                "C_Cpp.intelliSenseEngine": "disabled",
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },

    "remoteUser": "root"
}
