// Behaviour tree development, on the `orchestrator` service of docker-compose.dev.yml.
{
    "name": "orchestrator",

    "dockerComposeFile": [
        "../../docker-compose.dev.yml"
    ],
    "service": "orchestrator",
    "runServices": ["orchestrator"],
    "workspaceFolder": "/workspace",

    // Closing the window must not stop inference in another one.
    "shutdownAction": "none",

    // The image has dependencies only; colcon-defaults-orchestrator.yaml says what to build.
    // Capped, or the C++ build runs the machine out of RAM.
    "postCreateCommand": "bash -c 'source /ros-env.sh && MAKEFLAGS=-j2 colcon build --symlink-install --parallel-workers 1'",

    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "openai.chatgpt",
                "llvm-vs-code-extensions.vscode-clangd",
                // Only for the debugger: it owns cppdbg. IntelliSense off below.
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                // Replaces ms-iot.vscode-ros, which is archived.
                "Ranch-Hand-Robotics.rde-ros-2"
            ],
            "settings": {
                // The merged file, so jumping into behaviortree_ros2 works.
                "clangd.arguments": [
                    "--compile-commands-dir=/opt/colcon_ws/build"
                ],
                // clangd reads the code; two engines would fight over it.
                "C_Cpp.intelliSenseEngine": "disabled",
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },

    "remoteUser": "root"
}
