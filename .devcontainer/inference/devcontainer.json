// GPU inference development. Run git lfs pull on the host before starting
// inference, so the model weights are real files and not LFS pointers.
{
    "name": "inference",

    "dockerComposeFile": [
        "../../docker-compose.dev.yml"
    ],
    "service": "inference",
    "runServices": ["inference"],

    // Runs on the host: lets root in the container use the host display, for
    // rqt_image_view. Harmless where there is no display.
    "initializeCommand": "xhost +SI:localuser:root >/dev/null 2>&1 || true",
    "workspaceFolder": "/workspace",

    // Closing the window keeps the container up, so its build survives.
    "shutdownAction": "none",

    "postCreateCommand": "bash -c 'source /ros-env.sh && colcon build --symlink-install --packages-select tvarometr_interfaces tvarometr_inference'",

    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "openai.chatgpt",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "ms-iot.vscode-ros"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3",
                "python.analysis.extraPaths": [
                    "/opt/ros/humble/lib/python3.10/site-packages",
                    "/opt/ros/humble/local/lib/python3.10/dist-packages",
                    "/opt/colcon_ws/install/tvarometr_interfaces/lib/python3.10/site-packages",
                    "/opt/colcon_ws/install/tvarometr_interfaces/local/lib/python3.10/dist-packages",
                    "/workspace/src/tvarometr_inference",
                    "/workspace/src/tvarometr_inference/tvarometr_inference/vendor"
                ],
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },

    "remoteUser": "root"
}
