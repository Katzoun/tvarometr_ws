<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tvarometr_inference</name>
  <version>0.0.0</version>
  <description>Face detection with age, gender and emotion estimation</description>
  <maintainer email="tomas.janousek02@gmail.com">Tomas Janousek</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <exec_depend>usb_cam</exec_depend>
  <depend>tvarometr_interfaces</depend>
  <exec_depend>python3-hersheyfonts</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
