<?xml version="1.0" encoding="UTF-8"?>
<!--
  The whole run: driver bring-up once, then one cycle per visitor.
  CentreFace and MockInference are still stand-ins; set succeed="false" on a
  MockAction to watch the branch that handles its failure.
-->
<root BTCPP_format="4" main_tree_to_execute="Tvarometr">
  <BehaviorTree ID="Tvarometr">
    <Sequence name="orchestrator">

      <!-- Whether the fixed labels are already on the board. The process
           assumes a clean board when it starts; the first run that gets the
           labels on sets this, and every run after it draws only the values. -->
      <Script code="board_written := false"/>

      <!-- Once, before anyone can ask for a run. The robot driver is a managed
           node and has to be active or no motion goal is accepted, so it is
           brought up here rather than by hand from a second terminal.

           The inference node is managed too, and belongs here in the same shape
           - it is left out while the inference stack is not part of the run, and
           MockInference stands in for it below. The trajectory node never
           belongs here: it holds no resource, so it is a plain node that is
           ready as soon as it is running.

           Ask whether the driver is already active, and only if it is not,
           configure and activate it. That makes restarting this process cheap:
           a driver that is up keeps its robot session.

           ForceSuccess on configure covers the node that is configured but not
           active: configure refuses, and activate is what decides. A genuine
           configure failure is not lost - it surfaces as the activate failing
           right after it, and the node itself logged the reason. -->
      <Sequence name="bring_up">
        <LogMessage message="Bringing the robot driver up."/>

        <Fallback name="driver_up">
          <IsNodeActive service_name="/robot_controller/get_state"/>
          <Sequence>
            <ForceSuccess>
              <ChangeLifecycleState service_name="/robot_controller/change_state"
                                    transition="configure"/>
            </ForceSuccess>
            <ChangeLifecycleState service_name="/robot_controller/change_state"
                                  transition="activate"/>
          </Sequence>
        </Fallback>
      </Sequence>

      <!-- Ticks the cycle again for as long as it keeps succeeding, which is
           for as long as the process lives: a run that ends early is caught
           below, so the only way out is Ctrl+C. -->
      <KeepRunningUntilFailure>
        <Sequence name="cycle">

          <LogMessage message="Ready. S starts a run, E aborts, Q acknowledges an abort."/>
          <WaitForStart/>

          <!-- The catch that makes an abort a return to waiting. Whatever ended
               the run early - E, a node that went away, or a step out of
               retries - lands on the log line below, which succeeds, so the
               cycle succeeds and comes round to WaitForStart again. -->
          <Fallback name="run_or_give_up">

            <!-- Reactive, so IsAbortClear is re-ticked on every pass through
                 the tree rather than once at the start. The moment it fails,
                 whichever step is running below is halted. -->
            <ReactiveSequence name="guarded">
              <IsAbortClear/>

              <Sequence name="run">

                <!-- A node can die, or be taken down the lifecycle by hand,
                     between one run and the next. Checked once per cycle, here
                     in a plain Sequence: IsNodeActive is a service call, so in
                     the reactive branch above it would ask twice a second for
                     as long as a run lasts.

                     The trajectory node cannot be checked this way and is not
                     worth a check of its own: if it is gone,
                     GenerateTrajectories fails and the Fallback above brings
                     the tree back to waiting - later than this, but
                     harmlessly. -->
                <IsNodeActive service_name="/robot_controller/get_state"/>

                <!-- Mastership, motors on, RAPID started. Here and not in the
                     bring-up, for two reasons. The motors come on when somebody
                     asks for a run, not when this process starts. And a motion
                     that fails stops RAPID - asking again at the top of every
                     run is what lets the next S recover instead of failing the
                     same way. When everything is already up it only answers
                     that it is. -->
                <RobotRequest command="make_robot_ready"/>

                <!-- Where the camera photographs from. A placeholder: set it
                     to a pose jogged to by hand before the first run. Degrees,
                     axes 1 to 6. The photo itself is still faked below. -->
                <MoveToJoints name="MoveToPhotoPose" joints_deg="0;0;0;0;0;0"
                              speed="300"/>

                <!-- One step, because the loop that frames the face belongs in
                     a node of its own: it wants the camera's rate rather than
                     the tick rate, and the gains and the convergence test are
                     control state, not blackboard state. It reports RUNNING
                     while it closes in, FAILURE when it runs out of time or
                     finds nobody. Its feedback is what tells an operator how it
                     is doing. -->
                <MockAction name="CentreFace" duration_ms="4000"/>

                <!-- The full model pass runs once, on a frame that is already
                     framed well - the centring loop reads a cheaper
                     detection.

                     Faked for now. MockInference writes the same message on
                     the same port the real node would, so everything below can
                     be built and watched with no camera and no GPU. Edit the
                     attributes here to draw a different face; swapping in the
                     real thing is <RunInference attributes="{attributes}"/>. -->
                <MockInference attributes="{attributes}"
                               age="32" gender="male" emotion="happiness"/>

                <!-- All three paths come back at once and all three land on
                     the blackboard; which of them the robot draws is decided
                     below. -->
                <GenerateTrajectories attributes="{attributes}"
                                      labels="{labels}"
                                      values="{values}"
                                      erase="{erase}"/>

                <!-- The labels go on once, onto a clean board. The flag is set
                     only once they are down, so a run aborted halfway through
                     them tries them again next time. -->
                <Precondition if="!board_written" else="SUCCESS">
                  <Sequence name="write_labels">
                    <ExecutePath name="DrawLabels" path="{labels}" speed="300"
                                 tool="tool_draw" wobj="draw_wobj"/>
                    <Script code="board_written = true"/>
                  </Sequence>
                </Precondition>

                <ExecutePath name="DrawValues" path="{values}" speed="300"
                             tool="tool_draw" wobj="draw_wobj"/>

                <!-- Away from the board before anything else moves: the switch
                     to the eraser turns the wrist, and it should not do that
                     with the pen a couple of centimetres off the surface. -->
                <SubTree ID="BackOff"/>

                <!-- The values stay on the board for as long as the visitor
                     wants to read them, and the operator says when that is.
                     Still inside the guard, so E works while it waits. -->
                <LogMessage message="Drawn. C erases the board, E aborts."/>
                <WaitForContinue/>

               <ExecutePath name="ChangeAndApproach" path="0.4,0.1,0.3,1,0,0,0" speed="300"
                 tool="tool_erase" wobj="draw_wobj"/>

                <!-- The eraser sits on the same flange as the pen, so erasing
                     is only another tool name, with no tool change and
                     nothing to wait for in between. For now both use the
                     pen's tooldata until the eraser has one of its own - with
                     a real pen fitted, this sweep draws over the values. -->
                <ExecutePath name="EraseValues" path="{erase}" speed="300"
                             tool="tool_erase" wobj="draw_wobj"/>

                <!-- And away again, so the next run's move to the photo pose
                     starts clear of the board. -->
                <SubTree ID="BackOff"/>
              </Sequence>

            </ReactiveSequence>

            <LogMessage message="Run ended early. Back to waiting."/>
          </Fallback>
        </Sequence>
      </KeepRunningUntilFailure>

    </Sequence>
  </BehaviorTree>

  <!-- The point the arm backs off to, closer to its base than the board is.
       Its own tree only so that the point is written down once and used from
       two places.

       A placeholder in wobj0, the robot base, metres: x,y,z then the ROS
       quaternion qx,qy,qz,qw - here the pen pointing straight down, as it draws.
       Empty wobj is wobj0. Set the point for the real cell before the first
       run. -->
  <BehaviorTree ID="BackOff">
    <ExecutePath name="BackOff" path="0.7,0.3,0.8,-0.701589459,0.659479492,-0.192839851,0.188869854" speed="300"
                 tool="tool_draw" wobj=""/>
  </BehaviorTree>
</root>