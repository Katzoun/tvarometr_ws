<?xml version="1.0" encoding="UTF-8"?>
<!-- The whole run: bring-up once, then one cycle per visitor. -->
<root BTCPP_format="4" main_tree_to_execute="Tvarometr">
  <BehaviorTree ID="Tvarometr">
    <Sequence name="orchestrator">

      <!-- Whether the labels are on the board; a clean board is assumed at start. -->
      <Script code="board_written := false"/>

      <!-- Managed nodes, only if not active yet: a restart keeps the robot session
           and the weights. Configure refuses a configured node, hence ForceSuccess. -->
      <Sequence name="bring_up">
        <LogMessage message="Bringing the robot driver and the inference node up."/>

        <Fallback name="driver_up">
          <IsNodeActive service_name="/robot_controller/get_state"/>
          <Sequence>
            <ForceSuccess>
              <ChangeLifecycleState service_name="/robot_controller/change_state"
                                    transition="configure"/>
            </ForceSuccess>
            <ChangeLifecycleState service_name="/robot_controller/change_state"
                                  transition="activate"/>
          </Sequence>
        </Fallback>

        <Fallback name="inference_up">
          <IsNodeActive service_name="/inference_node/get_state"/>
          <Sequence>
            <ForceSuccess>
              <ChangeLifecycleState service_name="/inference_node/change_state"
                                    transition="configure"/>
            </ForceSuccess>
            <ChangeLifecycleState service_name="/inference_node/change_state"
                                  transition="activate"/>
          </Sequence>
        </Fallback>
      </Sequence>

      <!-- Runs for as long as the process lives; an early end is caught below. -->
      <KeepRunningUntilFailure>
        <Sequence name="cycle">

          <LogMessage message="Ready. S starts a run, E aborts, Q acknowledges an abort."/>
          <WaitForStart/>

          <!-- Whatever ends a run early lands on the log line below, back to waiting. -->
          <Fallback name="run_or_give_up">

            <!-- Reactive: IsAbortClear is checked every tick, so E halts the running step. -->
            <ReactiveSequence name="guarded">
              <IsAbortClear/>

              <Sequence name="run">

                <!-- Once per run, outside the guard, which would call them on every tick. -->
                <IsNodeActive service_name="/robot_controller/get_state"/>
                <IsNodeActive service_name="/inference_node/get_state"/>

                <!-- At every run, so a motion failure that stopped RAPID recovers on the next S. -->
                <RobotRequest command="make_robot_ready"/>

                <!-- Every run starts off the board, wherever the last one left the arm. -->
                <SubTree ID="BackOff"/>

                <!-- Metres and ROS quaternion in wobj0. Keep the same pose in CentreFace and
                     BackToPhotoPose: centring never reads where the arm really is. -->
                <ExecutePath name="MoveToPhotoPose" path="-0.12,-0.9,1.2,1,0,0,0"
                             motion_command="MoveJ" speed="300"
                             tool="tool0" wobj="wobj0"/>

                <!-- Frame the visitor, then analyse them. If either fails: back to
                     the photo pose and wait - C tries both again, E aborts. -->
                <RetryUntilSuccessful num_attempts="-1">
                  <Fallback>
                    <Sequence name="frame_and_analyse">
                      <CentreFace photo_pose="-0.12,-0.9,1.2,1,0,0,0"
                                  tool="tool0" wobj="wobj0"/>
                      <RunInference attributes="{attributes}"/>
                    </Sequence>
                    <!-- Always fails, so that after C the retry runs both again. -->
                    <ForceFailure>
                      <Sequence name="ask_for_a_retry">
                        <ExecutePath name="BackToPhotoPose"
                                     path="-0.12,-0.9,1.2,1,0,0,0"
                                     motion_command="MoveL" speed="300"
                                     tool="tool0" wobj="wobj0"/>
                        <LogMessage message="No visitor analysed. C tries again, E aborts."/>
                        <WaitForContinue/>
                      </Sequence>
                    </ForceFailure>
                  </Fallback>
                </RetryUntilSuccessful>

                <!-- All three paths at once; what gets drawn is decided below. -->
                <GenerateTrajectories attributes="{attributes}"
                                      labels="{labels}"
                                      values="{values}"
                                      erase="{erase}"/>

                <!-- Labels once; the flag is set only after they are down. -->
                <Precondition if="!board_written" else="SUCCESS">
                  <Sequence name="write_labels">
                    <ExecutePath name="DrawLabels" path="{labels}" speed="300"
                                 tool="tool_draw" wobj="draw_wobj"/>
                    <Script code="board_written = true"/>
                  </Sequence>
                </Precondition>

                <ExecutePath name="DrawValues" path="{values}" speed="300"
                             tool="tool_draw" wobj="draw_wobj"/>

                <!-- Off the board before the wrist turns for the eraser. -->
                <SubTree ID="BackOff"/>

                <!-- The operator says when the visitor has read it; E still works here. -->
                <LogMessage message="Drawn. C erases the board, E aborts."/>
                <WaitForContinue/>

               <ExecutePath name="ChangeAndApproach" path="0.4,0.1,0.3,1,0,0,0" speed="300"
                 tool="tool_erase" wobj="draw_wobj"/>

                <!-- Same flange as the pen; tool_erase still uses the pen's tooldata. -->
                <ExecutePath name="EraseValues" path="{erase}" speed="300"
                             tool="tool_erase" wobj="draw_wobj"/>

                <!-- And off the board again. -->
                <SubTree ID="BackOff"/>
              </Sequence>

            </ReactiveSequence>

            <LogMessage message="Run ended early. Back to waiting."/>
          </Fallback>
        </Sequence>
      </KeepRunningUntilFailure>

    </Sequence>
  </BehaviorTree>

  <!-- Back-off point, its own tree because two places use it. Placeholder, wobj0. -->
  <BehaviorTree ID="BackOff">
    <ExecutePath name="BackOff" path="0.7,0.3,0.8,-0.701589459,0.659479492,-0.192839851,0.188869854" speed="300"
                 tool="tool_draw" wobj=""/>
  </BehaviorTree>
</root>