<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tvarometr_geometry</name>
  <version>0.0.0</version>
  <description>Turning what the camera found into coordinates the robot can go to</description>
  <maintainer email="tomas.janousek02@gmail.com">Tomas Janousek</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>tvarometr_interfaces</depend>
  <!-- The arm carries the camera, so framing a face is a motion goal. From the
       driver's repository, same as for the orchestrator. -->
  <depend>robot_control_msgs</depend>

  <!-- svg.path, which the drawing node vectorises text with, is not
       declared here: rosdep has no rule for it. It arrives by pip, from
       docker/requirements-orchestrator.txt. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
