# Where the visitor stands in a camera frame, from the detector alone.

# Only a frame taken at or after this counts; zero takes the newest.
builtin_interfaces/Time not_before
---
# True when somebody close enough to be the visitor is in the frame.
bool success
string message
sensor_msgs/RegionOfInterest person_bbox
# Zero size when their face is out of the frame or turned away.
sensor_msgs/RegionOfInterest face_bbox
uint32 image_width
uint32 image_height
