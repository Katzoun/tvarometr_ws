# The label, value and erase paths for one analysis, from one shared layout.
tvarometr_interfaces/FaceAttributes attributes
---
bool success
string message

# Metres in the board's frame, z=0 on the board; each path starts and ends lifted.

# The fixed labels, drawn once onto a clean board.
geometry_msgs/PoseArray labels
# This run's answers, drawn every cycle.
geometry_msgs/PoseArray values
# Sweeps over the whole value column, whatever was written there.
geometry_msgs/PoseArray erase
