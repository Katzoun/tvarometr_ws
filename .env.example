ROS_DOMAIN_ID=42

# Inference device for the vision container: cpu or cuda:0
INFERENCE_DEVICE=cuda:0

# Webcam device passed into the vision container. Use /dev/null on machines
# without a webcam (the stack still starts, only the camera node fails).
CAMERA_DEVICE=/dev/video0

# sim = the driver's stand-in controller, no robot needed - it accepts every
#       motion goal and keeps the targets it was sent
# rws = connect to the real/virtual ABB controller via Robot Web Services
ROBOT_BACKEND=sim

# Robot Web Services connection (only used when ROBOT_BACKEND=rws)
ROBOT_IP=192.168.0.37
ROBOT_PORT=443
ROBOT_USERNAME=Admin
ROBOT_PASSWORD=robotics

# Set to false on a machine with no webcam - inference still runs
USE_CAMERA=false
